---
import { SITE_CONTENT } from "@config";
import Hero from "@components/Hero.astro";
import Layout from "@layouts/Layout.astro";
import AIExpertise from "@components/AIExpertise.astro";
import TechExpertise from "@components/TechExpertise.astro";
import Projects from "@components/Projects.astro";
import Experience from "@components/Experience.astro";
import About from "@components/About.astro";

import "../styles/global.css";
---

<Layout>
  <Hero {...SITE_CONTENT.hero} />
  <AIExpertise items={SITE_CONTENT.aiExpertise} />
  <TechExpertise items={SITE_CONTENT.techExpertise} />
  <Projects projects={SITE_CONTENT.projects} />
  <Experience experience={SITE_CONTENT.experience} />
  <About {...SITE_CONTENT.about} name={SITE_CONTENT.hero.name} />
</Layout>
