---
import Reveal from "./Reveal.astro";
import type { SiteConfig } from "@types";

type Props = Pick<SiteConfig, "author" | "socialLinks">;

const { author, socialLinks } = Astro.props;
const currentYear = new Date().getFullYear();
---

<Reveal variant="fade">
  <footer
    class="w-full border-t border-neutral/20 px-5 pt-5 pb-8 text-center text-white"
  >
    <ul class="mb-5 flex flex-wrap justify-center gap-x-5 text-xs">
      {
        socialLinks.map(({ text, href }) => (
          <li>
            <a
              href={href}
              target="_blank"
              class="link-underline inline-block px-4 py-3 transition-all duration-300 after:relative after:-bottom-1 after:content-[url(/external.svg)] hover:text-primary"
            >
              {text}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="text-xs text-neutral transition-colors duration-300">
      {author} © {currentYear}.
    </p>
  </footer>
</Reveal>
