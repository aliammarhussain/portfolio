---
import Section from "./Section.astro";
import Reveal from "./Reveal.astro";
import type { ExperienceProps } from "@types";

interface Props {
  experience: ExperienceProps[];
}

const { experience } = Astro.props;
---

<Section text="Work Experience" href="experience">
  <div class="space-y-2">
    {
      experience.map(({ company, position, startDate, endDate, summary }, i) => (
        <Reveal
          delay={i * 90}
          variant={i % 2 === 0 ? "left" : "right"}
        >
          <div class="timeline-card mb-10 rounded-xl border border-transparent py-2 pr-4 pl-6 transition-all duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-primary/10 hover:bg-primary/5">
            <h3 class="mb-1.5 font-serif text-2xl font-semibold text-white">
              {company}
            </h3>
            <div class="flex flex-col items-start pb-5">
              <h4 class="mb-0.5 font-serif text-2xl font-medium text-primary">
                {position}
              </h4>
              <span class="rounded-full bg-white/5 px-3 py-0.5 text-sm text-white/70 transition-colors duration-300 hover:bg-primary/10">
                {startDate} — {endDate}
              </span>
            </div>
            {Array.isArray(summary) ? (
              <ul class="list-none">
                {summary.map((log) => (
                  <li class="relative mb-3 pl-8 text-base text-neutral transition-colors duration-300 hover:text-white/90 before:absolute before:top-1 before:left-0 before:content-[url(/check.svg)]">
                    {log}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-base text-neutral">{summary}</p>
            )}
          </div>
        </Reveal>
      ))
    }
  </div>
</Section>
