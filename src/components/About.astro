---
import Section from "./Section.astro";
import Reveal from "./Reveal.astro";
import { Image } from "astro:assets";
import type { AboutProps, HeroProps } from "@types";

type Props = AboutProps & Pick<HeroProps, "name">;

const { description, image, name } = Astro.props;
---

<Section text="About Me" href="about">
  <div class="flex flex-col items-center gap-12 md:flex-row md:gap-10">
    <Reveal variant="left" class="flex-1">
      <p class="w-auto text-base leading-relaxed text-neutral md:pr-5">
        {description}
      </p>
    </Reveal>
    <Reveal variant="right" delay={120}>
      <div
        class="photo-frame relative h-80 w-64 shrink-0 rotate-[5deg] bg-white p-4 md:rotate-[7deg]"
      >
        <div
          class="pointer-events-none absolute -inset-2 -z-10 rounded-2xl bg-gradient-to-br from-primary/30 to-transparent opacity-60 blur-xl transition-opacity duration-700"
          aria-hidden="true"
        >
        </div>
        <Image
          class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]"
          src={image}
          width="260"
          height="260"
          alt={name}
        />
      </div>
    </Reveal>
  </div>
</Section>
