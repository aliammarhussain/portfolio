---
import Section from "./Section.astro";
import Reveal from "./Reveal.astro";
import { Image } from "astro:assets";
import { getImageUrl } from "../assets/images";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;

const aiProjects = projects.filter((p) => p.aiPlatform || p.flagship);
const otherProjects = projects.filter((p) => !p.aiPlatform && !p.flagship);
---

<Section text="AI Platforms & Projects" href="projects">
  <Reveal variant="fade">
    <p class="mb-12 max-w-3xl text-base text-neutral md:text-lg">
      Production AI systems built for real enterprise use. Each platform delivers
      intelligent workflows through RAG, agents, multimodal AI, workflow
      orchestration, and tool calling — with applications serving as the delivery
      layer, not the achievement.
    </p>
  </Reveal>

  <div class="mb-16 space-y-12">
    {
      aiProjects.map((project, projectIndex) => {
        const {
          name,
          summary,
          tagline,
          flagship,
          category,
          technologies,
          highlights,
          features,
          images,
          image,
          linkPreview,
          linkSource,
        } = project;
        const hasLinks = linkPreview || linkSource;

        return (
          <Reveal delay={projectIndex * 100} variant="blur">
            <div
              class:list={[
                "project-card relative overflow-hidden rounded-2xl border bg-black",
                flagship
                  ? "project-card-flagship mb-12 border-primary/30 shadow-[0_0_48px_-16px_rgba(37,99,235,0.4)]"
                  : "mb-10 border-neutral/20",
              ]}
            >
              {flagship && (
                <div
                  class="pointer-events-none absolute -top-24 -right-24 h-48 w-48 rounded-full bg-primary/10 blur-3xl"
                  aria-hidden="true"
                />
              )}
              <div class="relative w-full rounded-2xl bg-[#1c232d] px-6 py-10 md:px-10 md:py-12">
                <div class="mb-6 flex flex-wrap items-center gap-3">
                  {flagship && (
                    <span class="rounded-full border border-primary/40 bg-primary/10 px-3 py-1 text-xs font-medium tracking-wide text-primary uppercase">
                      Flagship · Enterprise AI
                    </span>
                  )}
                  {category && (
                    <span class="rounded-full border border-neutral/30 bg-black/40 px-3 py-1 text-xs font-medium text-neutral">
                      {category}
                    </span>
                  )}
                </div>

                <h3 class="mb-2 font-serif text-3xl font-semibold text-white md:text-4xl">
                  {name}
                </h3>
                {tagline && (
                  <p class="text-gradient mb-4 font-serif text-xl md:text-2xl">
                    {tagline}
                  </p>
                )}
                <p class="mb-8 max-w-3xl text-base leading-relaxed text-neutral md:text-lg">
                  {summary}
                </p>

                {images && images.length > 0 && (
                  <div
                    class="project-gallery mb-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"
                    data-stagger-group
                    data-lightbox-gallery={name}
                  >
                    {images.map(({ src, alt, caption }) => (
                      <figure data-stagger-item class="project-shot group">
                        <button
                          type="button"
                          class="project-shot-btn w-full text-left"
                          data-lightbox-src={getImageUrl(src)}
                          data-lightbox-alt={alt}
                          data-lightbox-caption={caption ?? ""}
                          aria-label={`View full size: ${alt}`}
                        >
                          <div class="project-shot-frame overflow-hidden rounded-xl border border-neutral/20 bg-black/40">
                            <Image
                              class="project-shot-img w-full object-cover object-top transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-[1.03]"
                              src={src}
                              alt={alt}
                              width={1200}
                              height={750}
                              loading="lazy"
                            />
                            <span class="project-shot-zoom" aria-hidden="true">
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.5"
                                stroke="currentColor"
                                class="h-5 w-5"
                              >
                                <path
                                  stroke-linecap="round"
                                  stroke-linejoin="round"
                                  d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15"
                                ></path>
                              </svg>
                            </span>
                          </div>
                        </button>
                        {caption && (
                          <figcaption class="mt-3 text-center text-xs font-medium tracking-wide text-neutral uppercase">
                            {caption}
                          </figcaption>
                        )}
                      </figure>
                    ))}
                  </div>
                )}

                {highlights && highlights.length > 0 && (
                  <ul class="mb-8 grid gap-3 md:grid-cols-2">
                    {highlights.map((item) => (
                      <li class="relative rounded-lg border border-transparent bg-black/20 py-2 pl-8 text-sm text-white/90 transition-colors hover:border-primary/15 hover:bg-primary/5 before:absolute before:top-2.5 before:left-3 before:content-[url(/check.svg)] md:text-base">
                        {item}
                      </li>
                    ))}
                  </ul>
                )}

                {technologies && technologies.length > 0 && (
                  <div class="mb-8 flex flex-wrap gap-2">
                    {technologies.map((tech) => (
                      <span class="tech-badge rounded-lg border border-primary/20 bg-primary/5 px-3 py-1.5 text-xs font-medium text-primary/90">
                        {tech}
                      </span>
                    ))}
                  </div>
                )}

                {features && features.length > 0 && (
                  <div class="grid gap-4 md:grid-cols-2" data-stagger-group>
                    {features.map((feature) => (
                      <article
                        data-stagger-item
                        class="feature-card rounded-xl border border-neutral/15 bg-black/30 p-5"
                      >
                        <h4 class="mb-2 font-serif text-lg font-semibold text-white">
                          {feature.title}
                        </h4>
                        <p class="mb-3 text-sm leading-relaxed text-neutral">
                          {feature.description}
                        </p>
                        {feature.highlights && (
                          <ul class="space-y-1.5">
                            {feature.highlights.map((point) => (
                              <li class="text-xs text-white/75 before:mr-2 before:text-primary before:content-['▸']">
                                {point}
                              </li>
                            ))}
                          </ul>
                        )}
                      </article>
                    ))}
                  </div>
                )}

                {hasLinks && (
                  <div class="mt-8 flex gap-5 text-white">
                    {linkSource && (
                      <a
                        href={linkSource}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="transition-colors after:relative after:-bottom-1.25 after:content-[url(/external.svg)] hover:text-primary hover:underline"
                      >
                        Source
                      </a>
                    )}
                    {linkPreview && (
                      <a
                        href={linkPreview}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="transition-colors after:relative after:-bottom-1.25 after:content-[url(/external.svg)] hover:text-primary hover:underline"
                      >
                        Preview
                      </a>
                    )}
                  </div>
                )}

                {image && (
                  <div class="mt-8 overflow-hidden rounded-xl">
                    <Image
                      class="w-full object-cover transition-transform duration-500 hover:scale-[1.02]"
                      src={image}
                      alt={name}
                      width={736}
                      height={483}
                    />
                  </div>
                )}
              </div>
            </div>
          </Reveal>
        );
      })
    }
  </div>

  {
    otherProjects.length > 0 && (
      <div>
        <Reveal variant="fade">
          <h3 class="mb-8 font-serif text-2xl font-semibold text-white md:text-3xl">
            Additional Projects
          </h3>
        </Reveal>
        <div class="grid gap-4 md:grid-cols-2" data-stagger-group>
          {otherProjects.map(({ name, summary, linkPreview }) => (
            <article
              data-stagger-item
              class="glass-card h-full rounded-xl border border-neutral/20 p-6"
            >
              <h4 class="mb-2 font-serif text-xl font-medium text-primary">
                {name}
              </h4>
              <p class="text-sm leading-relaxed text-neutral">{summary}</p>
              {linkPreview && (
                <a
                  href={linkPreview}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-4 inline-block text-sm text-white transition-colors after:relative after:-bottom-1.25 after:content-[url(/external.svg)] hover:text-primary hover:underline"
                >
                  Watch Demo
                </a>
              )}
            </article>
          ))}
        </div>
      </div>
    )
  }
</Section>
