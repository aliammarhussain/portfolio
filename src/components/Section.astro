---
interface Props {
  text: string;
  href: string;
}

const { text, href } = Astro.props;
---

<section id={href} class="py-24">
  <div class="reveal reveal-blur mb-14" data-reveal>
    <h2
      class="section-heading font-serif text-4xl font-bold tracking-tighter text-white md:text-5xl"
    >
      {text}
    </h2>
    <div class="section-divider mt-6 h-px w-16 bg-primary/30" aria-hidden="true"
    ></div>
  </div>
  <slot />
</section>
